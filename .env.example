# Cliente: substitua pelo endereço público do servidor antes de npm run build.
VITE_SERVER_URL=
# Servidor local (Docker fixa PORT=2567).
PORT=2567
SIMBIOSE_DEBUG=0
SIMBIOSE_MAX_ROOMS=40
SIMBIOSE_ROOMS_PER_IP=3
SIMBIOSE_CONNECTIONS_PER_IP=8
SIMBIOSE_MESSAGES_PER_SECOND=150
SIMBIOSE_MAX_PAYLOAD=1024
# Compose/Caddy: copie as variáveis para deploy/.env e substitua os exemplos.
GAME_DOMAIN=jogo.example.com
API_DOMAIN=jogo-api.example.com
ACME_EMAIL=voce@example.com
TAG=latest
